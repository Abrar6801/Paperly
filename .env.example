# ─── Convex ───────────────────────────────────────────────────────────────────
# Get these from https://dashboard.convex.dev after running `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ─── Clerk ────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ─── Liveblocks ───────────────────────────────────────────────────────────────
# Get this from https://liveblocks.io/dashboard → your project → API Keys
LIVEBLOCKS_SECRET_KEY=

# ─── Convex Dashboard Environment Variables ───────────────────────────────────
# The following must be set in the Convex dashboard (not in this file):
#   CLERK_JWT_ISSUER_DOMAIN  →  your Clerk Frontend API URL
#     e.g. https://<your-clerk-instance>.clerk.accounts.dev  (dev)
#          https://<your-clerk-instance>.clerk.accounts.com  (prod)
#   See: https://docs.convex.dev/auth/clerk#configuring-dev-and-prod-instances
